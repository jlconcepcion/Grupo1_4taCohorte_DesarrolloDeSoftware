# Proveedor de correo: "smtp" (Mailgrid SMTP / Mailpit local) o "mailgrid-api" (API HTTP REST de Mailgrid)
EMAIL_PROVIDER=smtp
SMTP_HOST=cloud.mailgrid.net.br
SMTP_PORT=587
SMTP_USER=reemplazar_usuario_mailgrid
SMTP_PASS=reemplazar_clave_mailgrid
SMTP_FROM="FitBook Gimnasio <no-responder@ejemplo.com>"

# Opcional: modo API HTTP REST de Mailgrid (cuando EMAIL_PROVIDER=mailgrid-api)
MAILGRID_API_URL=https://api.mailgrid.net.br/send/
MAILGRID_API_KEY=reemplazar_api_key_mailgrid
MAILGRID_FROM_EMAIL=no-responder@ejemplo.com
MAILGRID_FROM_NAME="FitBook Gimnasio y Canchas"

